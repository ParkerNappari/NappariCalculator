<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Scientific Calculator</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #050B18;
    --surface: #0A1A2F;
    --surface2: #0D2040;
    --border: #3A5F7A;
    --border-dim: #1E3A52;
    --accent: #2ECBFF;
    --accent-bright: #5FDFFF;
    --accent2: #1A8FBB;
    --text: #E6F7FF;
    --text-mid: #CFEFFF;
    --text-dim: #3A5F7A;
    --btn-num: #0A1A2F;
    --btn-op: #0D2244;
    --btn-fn: #071526;
    --btn-eq: #082A40;
    --glow: 0 0 14px rgba(46,203,255,0.4);
    --glow-soft: 0 0 8px rgba(46,203,255,0.2);
    --glow-bright: 0 0 20px rgba(95,223,255,0.5);
  }

  body {
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Share Tech Mono', monospace;
    background-image:
      radial-gradient(ellipse at 15% 85%, rgba(46,203,255,0.07) 0%, transparent 55%),
      radial-gradient(ellipse at 85% 15%, rgba(95,223,255,0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 50%, rgba(10,26,47,0.8) 0%, transparent 80%);
  }

  .calc-wrapper {
    position: relative;
    padding: 1.5px;
    border-radius: 20px;
    background: linear-gradient(135deg,
      rgba(46,203,255,0.5) 0%,
      rgba(46,203,255,0.1) 30%,
      rgba(58,95,122,0.2) 60%,
      rgba(46,203,255,0.3) 100%
    );
    box-shadow:
      0 0 80px rgba(46,203,255,0.08),
      0 0 40px rgba(46,203,255,0.05),
      0 30px 80px rgba(0,0,0,0.7);
    animation: fadeIn 0.6s ease;
  }

  /* Subtle scan line overlay */
  .calc-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(46,203,255,0.012) 2px,
      rgba(46,203,255,0.012) 4px
    );
    pointer-events: none;
    z-index: 10;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .calc {
    background: var(--surface);
    border-radius: 19px;
    padding: 24px;
    width: 380px;
    overflow: hidden;
    position: relative;
  }

  /* Corner decorations */
  .calc::before, .calc::after {
    content: '';
    position: absolute;
    width: 40px;
    height: 40px;
    border-color: var(--accent);
    border-style: solid;
    opacity: 0.3;
  }
  .calc::before {
    top: 10px; left: 10px;
    border-width: 1px 0 0 1px;
    border-radius: 4px 0 0 0;
  }
  .calc::after {
    bottom: 10px; right: 10px;
    border-width: 0 1px 1px 0;
    border-radius: 0 0 4px 0;
  }

  /* Header */
  .calc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .calc-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--accent);
    text-transform: uppercase;
    text-shadow: 0 0 10px rgba(46,203,255,0.6);
  }
  .mode-badge {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--accent-bright);
    opacity: 0.8;
    text-transform: uppercase;
    font-family: 'Orbitron', sans-serif;
    background: rgba(46,203,255,0.08);
    border: 1px solid rgba(46,203,255,0.25);
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* Display */
  .display {
    background: var(--bg);
    border: 1px solid var(--border-dim);
    border-top-color: rgba(46,203,255,0.2);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
  }
  .display::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(46,203,255,0.4), transparent);
  }
  .display::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(46,203,255,0.03) 0%, transparent 50%);
    pointer-events: none;
  }
  .display-history {
    font-size: 11px;
    color: var(--text-dim);
    text-align: right;
    min-height: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-bottom: 6px;
    letter-spacing: 0.5px;
  }
  .display-main {
    font-family: 'Orbitron', sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--text);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.1;
    transition: color 0.15s;
    letter-spacing: 1px;
  }
  .display-main.error { color: #FF6B6B; font-size: 20px; }
  .display-main.result {
    color: var(--accent-bright);
    text-shadow: 0 0 16px rgba(95,223,255,0.6);
  }

  /* Angle mode toggle */
  .angle-row {
    display: flex;
    gap: 6px;
    margin-bottom: 14px;
  }
  .angle-btn {
    flex: 1;
    padding: 5px 0;
    background: var(--bg);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    color: var(--text-dim);
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.15s;
    text-transform: uppercase;
  }
  .angle-btn.active {
    background: rgba(46,203,255,0.08);
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: var(--glow-soft);
    text-shadow: 0 0 8px rgba(46,203,255,0.5);
  }
  .angle-btn:hover:not(.active) {
    border-color: #1E3A52;
    color: var(--text-mid);
  }

  /* Button Grid */
  .btn-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  /* Buttons */
  .btn {
    position: relative;
    padding: 0;
    height: 52px;
    border: 1px solid var(--border-dim);
    border-radius: 10px;
    background: var(--btn-num);
    color: var(--text-mid);
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.12s ease;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1px;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .btn sub {
    font-size: 8px;
    color: var(--text-dim);
    letter-spacing: 0px;
    line-height: 1;
    margin-top: -1px;
  }
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(46,203,255,0);
    transition: background 0.12s;
    border-radius: inherit;
  }
  .btn:active::after { background: rgba(46,203,255,0.08); }

  .btn:hover {
    border-color: var(--border);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0,0,0,0.4), 0 0 6px rgba(46,203,255,0.08);
  }
  .btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  /* Button variants */
  .btn.fn {
    background: var(--btn-fn);
    color: #7ECFED;
    font-size: 12px;
    border-color: rgba(46,203,255,0.1);
  }
  .btn.fn:hover {
    border-color: rgba(46,203,255,0.35);
    color: var(--accent-bright);
    box-shadow: 0 0 10px rgba(46,203,255,0.15), 0 4px 14px rgba(0,0,0,0.4);
  }

  .btn.op {
    background: var(--btn-op);
    color: var(--accent);
    border-color: rgba(46,203,255,0.2);
    font-size: 18px;
    text-shadow: 0 0 8px rgba(46,203,255,0.4);
  }
  .btn.op:hover {
    border-color: var(--accent);
    box-shadow: var(--glow);
    color: var(--accent-bright);
  }

  .btn.eq {
    background: linear-gradient(135deg, #082A40, #0D3D5A);
    color: var(--accent-bright);
    border-color: rgba(46,203,255,0.45);
    font-size: 22px;
    font-weight: bold;
    box-shadow: inset 0 0 20px rgba(46,203,255,0.07);
    text-shadow: 0 0 12px rgba(95,223,255,0.7);
  }
  .btn.eq:hover {
    background: linear-gradient(135deg, #0D3D5A, #114860);
    border-color: var(--accent-bright);
    box-shadow: var(--glow-bright), 0 4px 20px rgba(46,203,255,0.2);
  }

  .btn.clear {
    background: #071018;
    color: #FF8585;
    border-color: rgba(255,100,100,0.2);
  }
  .btn.clear:hover {
    border-color: rgba(255,100,100,0.5);
    box-shadow: 0 0 12px rgba(255,100,100,0.2), 0 4px 14px rgba(0,0,0,0.4);
    color: #FF9999;
  }

  .btn.num { font-size: 18px; color: var(--text); }
  .btn.num:hover { color: var(--text-mid); }

  /* Ripple */
  .ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(46,203,255,0.15);
    transform: scale(0);
    animation: ripple 0.4s ease-out forwards;
    pointer-events: none;
  }
  @keyframes ripple {
    to { transform: scale(4); opacity: 0; }
  }

  /* Result flash */
  @keyframes resultFlash {
    0% { color: var(--accent-bright); text-shadow: 0 0 20px rgba(95,223,255,0.8); }
    100% { color: var(--text); text-shadow: none; }
  }
</style>
</head>
<body>

<div class="calc-wrapper">
  <div class="calc">
    <div class="calc-header">
      <span class="calc-title">SCI · CALC</span>
      <span class="mode-badge" id="modeLabel">DEG</span>
    </div>

    <div class="display">
      <div class="display-history" id="history"></div>
      <div class="display-main" id="mainDisplay">0</div>
    </div>

    <div class="angle-row">
      <button class="angle-btn active" id="degBtn" onclick="setAngle('deg')">DEG</button>
      <button class="angle-btn" id="radBtn" onclick="setAngle('rad')">RAD</button>
      <button class="angle-btn" id="gradBtn" onclick="setAngle('grad')">GRAD</button>
    </div>

    <div class="btn-grid">
      <!-- Row 1: Functions -->
      <button class="btn fn" onclick="inputFn('sin(')">sin<sub>θ</sub></button>
      <button class="btn fn" onclick="inputFn('cos(')">cos<sub>θ</sub></button>
      <button class="btn fn" onclick="inputFn('tan(')">tan<sub>θ</sub></button>
      <button class="btn fn" onclick="inputFn('log(')">log</button>
      <button class="btn fn" onclick="inputFn('ln(')">ln</button>

      <!-- Row 2: Functions -->
      <button class="btn fn" onclick="inputFn('asin(')">sin⁻¹</button>
      <button class="btn fn" onclick="inputFn('acos(')">cos⁻¹</button>
      <button class="btn fn" onclick="inputFn('atan(')">tan⁻¹</button>
      <button class="btn fn" onclick="inputFn('sqrt(')">√</button>
      <button class="btn fn" onclick="inputFn('^')">xʸ</button>

      <!-- Row 3: Functions -->
      <button class="btn fn" onclick="inputFn('pi')">π</button>
      <button class="btn fn" onclick="inputFn('e')">e</button>
      <button class="btn fn" onclick="inputFn('abs(')">|x|</button>
      <button class="btn fn" onclick="inputFn('(')">(</button>
      <button class="btn fn" onclick="inputFn(')')">)</button>

      <!-- Row 4: Clear + operators -->
      <button class="btn clear" onclick="allClear()">AC</button>
      <button class="btn clear" onclick="backspace()">⌫</button>
      <button class="btn fn" onclick="inputFn('%')">%</button>
      <button class="btn op" onclick="inputFn('/')">÷</button>
      <button class="btn fn" onclick="toggleSign()">±</button>

      <!-- Row 5: Numbers + × -->
      <button class="btn num" onclick="inputNum('7')">7</button>
      <button class="btn num" onclick="inputNum('8')">8</button>
      <button class="btn num" onclick="inputNum('9')">9</button>
      <button class="btn op" onclick="inputFn('*')">×</button>
      <button class="btn fn" onclick="inputFn('x²')">x²</button>

      <!-- Row 6: Numbers + − -->
      <button class="btn num" onclick="inputNum('4')">4</button>
      <button class="btn num" onclick="inputNum('5')">5</button>
      <button class="btn num" onclick="inputNum('6')">6</button>
      <button class="btn op" onclick="inputFn('-')">−</button>
      <button class="btn fn" onclick="inputFn('1/x')">1/x</button>

      <!-- Row 7: Numbers + + -->
      <button class="btn num" onclick="inputNum('1')">1</button>
      <button class="btn num" onclick="inputNum('2')">2</button>
      <button class="btn num" onclick="inputNum('3')">3</button>
      <button class="btn op" onclick="inputFn('+')">+</button>
      <button class="btn fn" onclick="factorial()">n!</button>

      <!-- Row 8: 0, dot, = -->
      <button class="btn num" onclick="inputNum('0')" style="grid-column: span 2;">0</button>
      <button class="btn num" onclick="inputDot()">.</button>
      <button class="btn eq" onclick="calculate()">=</button>
      <button class="btn fn" onclick="memoryClear()" style="color:#3A5F7A; font-size:11px;">MC</button>

      <!-- Row 9: Memory -->
      <button class="btn fn" onclick="memoryRecall()" style="font-size:11px;">MR</button>
      <button class="btn fn" onclick="memoryAdd()" style="font-size:11px;">M+</button>
      <button class="btn fn" onclick="memorySub()" style="font-size:11px;">M−</button>
      <button class="btn fn" onclick="memoryStore()" style="font-size:11px;">MS</button>
      <button class="btn fn" onclick="inputFn('EE')">EE</button>
    </div>
  </div>
</div>

<script>
  let expression = '';
  let justEvaluated = false;
  let angleMode = 'deg';
  let memory = 0;

  const display = document.getElementById('mainDisplay');
  const history = document.getElementById('history');

  function toRad(x) {
    if (angleMode === 'rad') return x;
    if (angleMode === 'grad') return x * Math.PI / 200;
    return x * Math.PI / 180;
  }
  function fromRad(x) {
    if (angleMode === 'rad') return x;
    if (angleMode === 'grad') return x * 200 / Math.PI;
    return x * 180 / Math.PI;
  }

  function setAngle(mode) {
    angleMode = mode;
    document.getElementById('degBtn').classList.toggle('active', mode === 'deg');
    document.getElementById('radBtn').classList.toggle('active', mode === 'rad');
    document.getElementById('gradBtn').classList.toggle('active', mode === 'grad');
    document.getElementById('modeLabel').textContent = mode.toUpperCase();
  }

  function updateDisplay(value, isResult) {
    display.className = 'display-main' + (isResult ? ' result' : '');
    let formatted = String(value);
    if (!isNaN(formatted) && formatted.includes('.') && formatted.length > 14) {
      formatted = parseFloat(value).toPrecision(10).replace(/\.?0+$/, '');
    }
    display.textContent = formatted || '0';
  }

  function showError(msg) {
    display.className = 'display-main error';
    display.textContent = msg;
    setTimeout(() => updateDisplay(expression || '0', false), 1800);
  }

  function inputNum(n) {
    if (justEvaluated) { expression = ''; justEvaluated = false; }
    if (expression.length > 40) return;
    expression += n;
    updateDisplay(expression, false);
  }

  function inputDot() {
    if (justEvaluated) { expression = '0'; justEvaluated = false; }
    const parts = expression.split(/[\+\-\*\/\^\(]/);
    const last = parts[parts.length - 1];
    if (last.includes('.')) return;
    if (last === '' || expression === '') expression += '0';
    expression += '.';
    updateDisplay(expression, false);
  }

  function inputFn(fn) {
    if (justEvaluated) {
      if (!['+','-','*','/','^','%'].includes(fn)) expression = '';
      justEvaluated = false;
    }
    if (expression.length > 60) return;
    if (fn === 'pi')  { expression += 'Math.PI'; }
    else if (fn === 'e') { expression += 'Math.E'; }
    else if (fn === 'x²') { expression += '^2'; }
    else if (fn === '1/x') { expression = '1/(' + expression + ')'; }
    else if (fn === 'EE') { expression += 'e'; }
    else { expression += fn; }
    updateDisplay(expression
      .replace(/Math\.PI/g, 'π')
      .replace(/Math\.E/g, 'e')
      .replace(/\*/g, '×')
      .replace(/\//g, '÷'), false);
  }

  function toggleSign() {
    if (expression === '' || expression === '0') return;
    if (expression.startsWith('-')) expression = expression.slice(1);
    else expression = '-' + expression;
    updateDisplay(expression, false);
  }

  function backspace() {
    if (justEvaluated) { expression = ''; justEvaluated = false; updateDisplay('0', false); return; }
    expression = expression.slice(0, -1);
    updateDisplay(expression || '0', false);
  }

  function allClear() {
    expression = '';
    justEvaluated = false;
    history.textContent = '';
    updateDisplay('0', false);
  }

  function factorial() {
    try {
      const val = parseFloat(eval(expression));
      if (val < 0 || !Number.isInteger(val) || val > 170) { showError('Invalid'); return; }
      let result = 1;
      for (let i = 2; i <= val; i++) result *= i;
      history.textContent = expression + '!';
      expression = String(result);
      justEvaluated = true;
      updateDisplay(result, true);
    } catch { showError('Error'); }
  }

  function memoryClear() { memory = 0; flashMemory('MC'); }
  function memoryRecall() {
    if (justEvaluated) { expression = ''; justEvaluated = false; }
    expression += String(memory);
    updateDisplay(expression, false);
  }
  function memoryStore() {
    try { memory = parseFloat(eval(buildEvalStr(expression))); flashMemory('MS'); } catch {}
  }
  function memoryAdd() {
    try { memory += parseFloat(eval(buildEvalStr(expression))); flashMemory('M+'); } catch {}
  }
  function memorySub() {
    try { memory -= parseFloat(eval(buildEvalStr(expression))); flashMemory('M−'); } catch {}
  }
  function flashMemory(label) {
    const old = history.textContent;
    history.textContent = `MEM = ${memory}`;
    setTimeout(() => { history.textContent = old; }, 1200);
  }

  function buildEvalStr(expr) {
    return expr
      .replace(/sin\(/g, `_sin(`)
      .replace(/cos\(/g, `_cos(`)
      .replace(/tan\(/g, `_tan(`)
      .replace(/asin\(/g, `_asin(`)
      .replace(/acos\(/g, `_acos(`)
      .replace(/atan\(/g, `_atan(`)
      .replace(/sqrt\(/g, `Math.sqrt(`)
      .replace(/log\(/g, `Math.log10(`)
      .replace(/ln\(/g, `Math.log(`)
      .replace(/abs\(/g, `Math.abs(`)
      .replace(/\^/g, `**`)
      .replace(/%/g, `/100`);
  }

  function calculate() {
    if (expression === '') return;
    const rawExpr = expression;
    try {
      const evalStr = buildEvalStr(expression);
      const result = (function() {
        const _sin  = x => Math.sin(toRad(x));
        const _cos  = x => Math.cos(toRad(x));
        const _tan  = x => Math.tan(toRad(x));
        const _asin = x => fromRad(Math.asin(x));
        const _acos = x => fromRad(Math.acos(x));
        const _atan = x => fromRad(Math.atan(x));
        return eval(evalStr);
      })();

      if (typeof result !== 'number' || !isFinite(result)) {
        showError(result === Infinity || result === -Infinity ? '∞' : 'Error');
        return;
      }

      let formatted = result;
      if (Math.abs(result) >= 1e15 || (Math.abs(result) < 1e-9 && result !== 0)) {
        formatted = result.toExponential(6).replace(/\.?0+e/, 'e');
      } else if (!Number.isInteger(result)) {
        formatted = parseFloat(result.toPrecision(12));
      }

      history.textContent = rawExpr
        .replace(/Math\.PI/g, 'π')
        .replace(/Math\.E(?![a-z])/g, 'e')
        .replace(/\*/g, '×')
        .replace(/\//g, '÷') + ' =';

      expression = String(result);
      justEvaluated = true;
      updateDisplay(formatted, true);

      display.style.animation = 'none';
      display.offsetHeight;
      display.style.animation = 'resultFlash 0.5s ease forwards';

    } catch(err) {
      showError('Syntax Error');
    }
  }

  document.addEventListener('keydown', e => {
    if (e.key >= '0' && e.key <= '9') inputNum(e.key);
    else if (e.key === '.') inputDot();
    else if (e.key === '+') inputFn('+');
    else if (e.key === '-') inputFn('-');
    else if (e.key === '*') inputFn('*');
    else if (e.key === '/') { e.preventDefault(); inputFn('/'); }
    else if (e.key === '^') inputFn('^');
    else if (e.key === '(') inputFn('(');
    else if (e.key === ')') inputFn(')');
    else if (e.key === '%') inputFn('%');
    else if (e.key === 'Enter' || e.key === '=') calculate();
    else if (e.key === 'Backspace') backspace();
    else if (e.key === 'Escape') allClear();
  });

  document.querySelectorAll('.btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      const r = document.createElement('span');
      r.className = 'ripple';
      const rect = this.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      r.style.cssText = `width:${size}px;height:${size}px;left:${e.clientX-rect.left-size/2}px;top:${e.clientY-rect.top-size/2}px`;
      this.appendChild(r);
      setTimeout(() => r.remove(), 500);
    });
  });
</script>
</body>
</html>
